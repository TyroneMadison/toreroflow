# --- Database & queues (dev defaults match infra/docker-compose.yml) ---
DATABASE_URL=postgresql://toreroflow:toreroflow@localhost:5432/toreroflow
REDIS_URL=redis://localhost:6379

# --- Object storage (M2+) ---
STORAGE_ENDPOINT=
STORAGE_BUCKET=
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=

# --- Secrets ---
TOKEN_ENCRYPTION_KEY=
JWT_SECRET=dev-only-change-me

# --- AI ---
ANTHROPIC_API_KEY=

# --- Publishing (M1+) ---
PUBLISH_PROVIDER=dryrun
PUBLISH_PROVIDER_API_KEY=

# --- Captions (M2+) ---
CAPTIONS_PROVIDER=whisper
CAPTIONS_API_KEY=

# --- App ---
API_PORT=4700
APP_BASE_URL=http://localhost:4700
OAUTH_REDIRECT_URL=

# --- Report publishing (Netlify) ---
# Personal access token, scoped to the account holding the reports site.
# Empty leaves publishing switched off; the Reports screen says so.
NETLIFY_AUTH_TOKEN=
# Site the report pages are deployed into (API id or name).
NETLIFY_SITE_ID=
# Public address client links are built from, when it differs from the site
# above. Reports live on their own Netlify site and torerone.com proxies
# /reports/* to it, so clients get a torerone.com link while the two sites
# keep deploying independently. Empty falls back to the deploy site's own URL.
REPORTS_PUBLIC_BASE=
