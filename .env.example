# --- Database & queues (dev defaults match infra/docker-compose.yml) ---
DATABASE_URL=postgresql://toreroflow:toreroflow@localhost:5432/toreroflow

# --- Object storage (M2+) ---
STORAGE_ENDPOINT=
STORAGE_BUCKET=
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=

# --- Secrets ---
TOKEN_ENCRYPTION_KEY=
JWT_SECRET=dev-only-change-me

# --- AI ---
ANTHROPIC_API_KEY=
# Optional: free Pexels stock search for Studio b-roll spots (pexels.com/api).
PEXELS_API_KEY=
# Sunra (Create > Carousels). Empty keeps the two observed nano-banana prices
# and building answers 503. SUNRA_API_BASE is optional, empty is https://api.sunra.ai.
SUNRA_API_KEY=
SUNRA_API_BASE=

# --- Publishing (M1+) ---
PUBLISH_PROVIDER=dryrun
PUBLISH_PROVIDER_API_KEY=

# Bots. A bot token minted with a name ({"name":"polly"} to POST /auth/bot-token)
# gets the operator's full access when the name is listed here (comma separated;
# empty turns it off). Unset means "polly". Other bots keep the whitelist.
BOT_FULL_ACCESS=polly
# Optional. A bot's own Zernio key, scoped in Zernio to its clients' profiles.
# Empty is fine: Polly then posts and moderates on PUBLISH_PROVIDER_API_KEY
# (the agency Zernio key) with her full access unchanged.
ZERNIO_API_KEY_POLLY=

# --- Captions (M2+) ---
CAPTIONS_PROVIDER=whisper
CAPTIONS_API_KEY=

# --- App ---
API_PORT=4700
APP_BASE_URL=http://localhost:4700
OAUTH_REDIRECT_URL=

# --- Report publishing (Netlify) ---
# Personal access token, scoped to the account holding the reports site.
# Empty leaves publishing switched off; the Reports screen says so.
NETLIFY_AUTH_TOKEN=
# Site the report pages are deployed into (API id or name).
NETLIFY_SITE_ID=
# Public address client links are built from, when it differs from the site
# above. Reports live on their own Netlify site and torerone.com proxies
# /reports/* to it, so clients get a torerone.com link while the two sites
# keep deploying independently. Empty falls back to the deploy site's own URL.
REPORTS_PUBLIC_BASE=

# Where the desktop app looks for the API.
#
# Unset means http://localhost:4700, which is the local stack. Point it at the
# server after the cutover, then rebuild the app: this is baked in at build
# time, not read at startup, so changing it means a new installer.
#
#   VITE_API_URL=https://api.torerone.com
VITE_API_URL=

# --- Reminder accounts (personal profiles that post by hand) ---
# Delivery is email via Resend; both must be set or reminder targets fail
# with a message saying exactly this.
RESEND_API_KEY=
REMINDER_FROM=hello@torerone.com
# Public base for the signed video link in the email. Defaults to VITE_API_URL.
PUBLIC_API_URL=

# --- Direct platform access (Google, for the YouTube Analytics API) ---
# A different thing from YOUTUBE_API_KEY above. The key reads public catalogue
# data; this reads what only the channel owner can see: shares, watch time and
# subscribers gained. From console.cloud.google.com, the "Toreroflow server"
# OAuth client. Empty means the connect link answers 503 rather than sending a
# client to a page that fails on Google's side.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Monthly client report sender: a refresh token for Toreronee@gmail.com
# (gmail.send scope), minted with the SAME client id and secret above. Empty
# means the 1st-of-month job only builds previews and
# GET /reports/monthly/preflight answers 503 naming what is missing.
# How to mint it: docs/monthly-report.md. Sending also needs the kill switch
# turned ON in the app (default OFF).
GMAIL_REFRESH_TOKEN=
# The public origin OAuth redirects come back to. Must match the Authorised
# redirect URI in each console character for character, and it is NOT the same
# host as PUBLIC_API_URL above: that one is the Tailscale Funnel the desktop app
# talks to, this one is the domain the platforms were told about.
#
#   OAUTH_REDIRECT_BASE=https://api.torerone.com
# No default on purpose. A fallback to the production domain would mean a laptop
# test binding a real client's credential on the live server.
OAUTH_REDIRECT_BASE=

# --- Public request form captcha (Cloudflare Turnstile) ---
# Both empty (the default) means the captcha is off. With the secret set,
# every POST /r/:token must carry a Turnstile token Cloudflare accepts; the
# site key is handed to the form by GET /r/:token. From the Cloudflare
# dashboard, Turnstile, the widget for the request form's domain.
TURNSTILE_SECRET_KEY=
TURNSTILE_SITE_KEY=
