generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  owner
  viewer
}

enum Platform {
  instagram
  tiktok
  youtube
  snapchat
  facebook
}

enum SocialAccountStatus {
  connected
  needs_reconnect
  error
}

enum MediaAssetStatus {
  uploaded
  processing
  ready
  failed
}

enum RenderStatus {
  queued
  processing
  ready
  failed
}

enum PostStatus {
  draft
  scheduled
  publishing
  posted
  failed
}

enum PostTargetStatus {
  scheduled
  publishing
  posted
  failed
}

enum ScheduleSource {
  best_time
  manual
}

enum VideoFormat {
  short_form
  long_form
}

enum JobStatus {
  queued
  active
  completed
  failed
}

model Agency {
  id               String   @id @default(cuid())
  name             String
  ownerEmail       String
  /// Stamped onto the year-end export. A CPA needs these, not just totals.
  legalName        String?
  ein              String?
  /// NAICS principal business activity code.
  businessCode     String?
  /// cash or accrual. Decides whether unpaid revenue appears in the export.
  accountingMethod String?  @default("cash")
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  users           User[]
  clients         Client[]
  alerts          SystemAlert[]
  revenueEntries  RevenueEntry[]
  expenses        Expense[]
  invoices        Invoice[]
  financialMonths FinancialMonth[]
}

/**
 * Something that failed in the background, kept until it stops failing.
 * Scheduled work has no operator watching it: a month-end republish that
 * fails at 3am only reaches a log file, so a client's page can sit stale for
 * weeks while the app looks healthy. These rows are what the app reads to say
 * otherwise.
 * Deliberately a live list of what is broken now, not an audit log. A check
 * that succeeds deletes its row, so a problem that fixed itself leaves
 * nothing behind to explain away. The API log keeps the history.
 */
model SystemAlert {
  id       String  @id @default(cuid())
  agencyId String
  /// Stable identity for one recurring problem, e.g.
  /// "report_publish_failed:<clientId>". A repeat updates this row rather
  /// than stacking, so one broken thing reads as one problem.
  key      String
  kind     String
  /// "error" blocks something working; "warning" still needs attention.
  severity String  @default("error")
  clientId String?
  /// Written for the operator, and says what to do about it.
  message  String
  /// The underlying failure, for when the message is not enough.
  detail   String?
  count    Int     @default(1)

  firstSeenAt DateTime  @default(now())
  lastSeenAt  DateTime  @default(now())
  /// Acknowledged by the operator. Cleared again if it recurs, because a
  /// second failure after acknowledging is new information.
  dismissedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  agency Agency  @relation(fields: [agencyId], references: [id])
  client Client? @relation(fields: [clientId], references: [id])

  @@unique([agencyId, key])
  @@index([agencyId, dismissedAt])
}

model User {
  id           String   @id @default(cuid())
  agencyId     String
  email        String   @unique
  passwordHash String
  role         UserRole @default(owner)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  agency Agency @relation(fields: [agencyId], references: [id])
  posts  Post[]
}

model Client {
  id                   String         @id @default(cuid())
  agencyId             String
  name                 String
  avatarSeed           String?
  plan                 String?
  /// Publishing provider workspace id (Zernio profile _id) backing this client.
  providerProfileId    String?
  /// Short-form videos owed this pay period; null means not tracked.
  quotaShort           Int?
  /// Long-form videos owed this pay period; null means not tracked.
  quotaLong            Int?
  /// Start of the current pay period. Uploads after this count toward quota.
  quotaResetAt         DateTime?
  /// Manual corrections applied on top of the counted uploads, per format.
  adjustShort          Int            @default(0)
  adjustLong           Int            @default(0)
  /// Who to actually contact at this client, kept here rather than in a head.
  /// Separate from `name`, which is the brand: the brand is "CACV Motors" and
  /// the person answering the phone is someone else.
  contactName          String?
  contactEmail         String?
  contactPhone         String?
  /// Permanent path of this client's shareable web report, e.g.
  /// "northstar-end-of-month-report". Assigned once and never regenerated on
  /// rename, because the link may already be sitting in a client's inbox.
  reportSlug           String?        @unique
  /// Absolute URL of the last published report page; null until first publish.
  reportUrl            String?
  /// When that page was last pushed. Also the flag month-end republishing
  /// reads: a client that has never been published is never published for them.
  reportPublishedAt    DateTime?
  /// Reporting month the published page currently leads with ("2026-06").
  reportPublishedMonth String?
  /// Current retainer. A default for seeding a month, not a historical record:
  /// history lives in RevenueEntry, so raising this leaves past months alone.
  monthlyPriceCents    Int?
  /// calendar: paid monthly regardless of delivery.
  /// on_fulfilment: the next payment is not due until the last block ships.
  billingMode          String         @default("calendar")
  revenueEntries       RevenueEntry[]
  invoices             Invoice[]
  createdAt            DateTime       @default(now())
  updatedAt            DateTime       @updatedAt
  deletedAt            DateTime?

  agency         Agency          @relation(fields: [agencyId], references: [id])
  socialAccounts SocialAccount[]
  mediaAssets    MediaAsset[]
  posts          Post[]
  scheduleSlots  ScheduleSlot[]
  workflows      Workflow[]
  reports        ClientReport[]
  alerts         SystemAlert[]

  @@index([agencyId])
}

model SocialAccount {
  id                String              @id @default(cuid())
  clientId          String
  platform          Platform
  handle            String
  providerAccountId String?
  status            SocialAccountStatus @default(connected)
  /// Encrypted blob (libsodium sealed box / KMS). Never store plaintext tokens.
  tokensEncrypted   String?
  /// Profile picture and display name captured from the platform via the provider.
  avatarUrl         String?
  displayName       String?
  scopes            String[]            @default([])
  connectedAt       DateTime            @default(now())
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt
  deletedAt         DateTime?

  client          Client           @relation(fields: [clientId], references: [id])
  postTargets     PostTarget[]
  metricSnapshots MetricSnapshot[]
  externalVideos  ExternalVideo[]

  @@index([clientId, platform])
}

model MediaAsset {
  id           String           @id @default(cuid())
  clientId     String
  storageKey   String
  originalName String
  durationSec  Float?
  width        Int?
  height       Int?
  status       MediaAssetStatus @default(uploaded)
  /// Timestamped transcript from the captions service: [{ start, end, text }]
  transcript   Json?
  /// AI-drafted post copy: { title, description, hashtags[] } (operator-editable)
  draftCopy    Json?
  /// Short-form or long-form, for quota purposes. Filled from duration
  /// during processing when still unset; the operator can override it.
  format       VideoFormat?
  /// A re-edit of an earlier upload: excluded from the client's video quota.
  isRevision   Boolean          @default(false)
  /// The upload this one revises, when known.
  revisionOfId String?
  /// Millisecond offset of the operator-chosen cover frame, when frame-picked.
  coverOffsetMs Int?
  /// Storage key of the chosen cover image (frame-extracted or uploaded).
  coverKey      String?
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt

  client     Client       @relation(fields: [clientId], references: [id])
  renders    Render[]
  posts      Post[]
  revisionOf MediaAsset?  @relation("AssetRevisions", fields: [revisionOfId], references: [id])
  revisions  MediaAsset[] @relation("AssetRevisions")

  @@index([clientId, status])
}

model Render {
  id           String       @id @default(cuid())
  mediaAssetId String
  platform     Platform
  aspect       String       @default("9:16")
  storageKey   String
  captionStyle String?
  status       RenderStatus @default(queued)
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  mediaAsset MediaAsset @relation(fields: [mediaAssetId], references: [id])

  @@index([mediaAssetId])
}

model Post {
  id           String     @id @default(cuid())
  clientId     String
  mediaAssetId String?
  createdById  String
  status       PostStatus @default(draft)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  deletedAt    DateTime?

  client     Client       @relation(fields: [clientId], references: [id])
  mediaAsset MediaAsset?  @relation(fields: [mediaAssetId], references: [id])
  createdBy  User         @relation(fields: [createdById], references: [id])
  targets    PostTarget[]

  @@index([clientId, status])
}

model PostTarget {
  id              String           @id @default(cuid())
  postId          String
  socialAccountId String
  platform        Platform
  caption         String?
  hashtags        String[]         @default([])
  /// Per-platform publish options: { instagram: {...} } or { youtubeTitle }.
  options         Json?
  scheduledAt     DateTime?
  status          PostTargetStatus @default(scheduled)
  remotePostId    String?
  remoteUrl       String?
  error           String?
  publishedAt     DateTime?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  post          Post          @relation(fields: [postId], references: [id])
  socialAccount SocialAccount @relation(fields: [socialAccountId], references: [id])
  postMetrics   PostMetric[]

  @@index([status, scheduledAt])
  @@index([socialAccountId])
}

/// Repurpose.io-style fan-out rule: a video posted to sourcePlatform for this
/// client is automatically republished to every platform in destinations.
model Workflow {
  id             String     @id @default(cuid())
  clientId       String
  name           String
  sourcePlatform Platform
  destinations   Platform[] @default([])
  enabled        Boolean    @default(true)
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt

  client Client @relation(fields: [clientId], references: [id])

  @@index([clientId, enabled])
}

model ScheduleSlot {
  id        String         @id @default(cuid())
  clientId  String
  platform  Platform
  dayOfWeek Int
  hourLocal Int
  source    ScheduleSource @default(manual)
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt

  client Client @relation(fields: [clientId], references: [id])

  @@index([clientId, platform])
}

/**
 * A generated client report for one calendar month.
 * The payload the PDF was built from is stored alongside it, so a report can
 * be re-rendered later without recomputing analytics that may since have
 * moved. `seenAt` drives the month-end notification.
 */
model ClientReport {
  id          String    @id @default(cuid())
  clientId    String
  /// First moment of the reporting month.
  periodStart DateTime
  periodEnd   DateTime
  /// Storage path of the rendered PDF.
  storageKey  String
  /// Exact JSON the template rendered, kept for reproducibility.
  data        Json
  generatedAt DateTime  @default(now())
  /// Null until the operator has opened it; the bell reads this.
  seenAt      DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  client Client @relation(fields: [clientId], references: [id])

  @@unique([clientId, periodStart])
  @@index([clientId, periodStart])
}

/**
 * A video that already existed on the platform, pulled straight from the
 * platform's own API rather than the publishing provider.
 * The provider only exposes a rolling window of recent posts, so lifetime
 * rankings ("most viewed of all time") need the platform as the source of
 * truth. View counts here are authoritative and refreshed on each sync.
 */
model ExternalVideo {
  id              String   @id @default(cuid())
  socialAccountId String
  platform        Platform
  /// The platform's own video id (e.g. a YouTube videoId).
  platformVideoId String
  title           String
  thumbnailUrl    String?
  url             String?
  publishedAt     DateTime
  views           Int      @default(0)
  likes           Int      @default(0)
  comments        Int      @default(0)
  durationSec     Float?
  fetchedAt       DateTime @default(now())
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  socialAccount SocialAccount @relation(fields: [socialAccountId], references: [id])

  @@unique([socialAccountId, platformVideoId])
  @@index([socialAccountId, views])
  @@index([socialAccountId, publishedAt])
}

model MetricSnapshot {
  id              String   @id @default(cuid())
  socialAccountId String
  capturedAt      DateTime
  views           Int?
  reach           Int?
  followers       Int?
  engagementRate  Float?
  avgWatchSec     Float?
  raw             Json?
  createdAt       DateTime @default(now())

  socialAccount SocialAccount @relation(fields: [socialAccountId], references: [id])

  @@index([socialAccountId, capturedAt])
}

model PostMetric {
  id           String   @id @default(cuid())
  postTargetId String
  capturedAt   DateTime
  views        Int?
  likes        Int?
  comments     Int?
  shares       Int?
  saves        Int?
  createdAt    DateTime @default(now())

  postTarget PostTarget @relation(fields: [postTargetId], references: [id])

  @@index([postTargetId, capturedAt])
}

/// Mirror of queue state so the UI can show job health without talking to Redis.
model Job {
  id        String    @id @default(cuid())
  type      String
  refId     String?
  status    JobStatus @default(queued)
  attempts  Int       @default(0)
  lastError String?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@index([type, status])
}

/// What one client owes for one month.
model RevenueEntry {
  id          String    @id @default(cuid())
  agencyId    String
  clientId    String
  /// "2026-06"
  month       String
  amountCents Int
  /// Set means paid. The only stored state: pending and due are derived, since
  /// a stored "not due" goes stale the moment a video is delivered.
  receivedAt  DateTime?
  note        String?
  color       String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  agency Agency @relation(fields: [agencyId], references: [id])
  client Client @relation(fields: [clientId], references: [id])

  @@unique([clientId, month])
  @@index([agencyId, month])
}

/// One cost in one month. Holds recurring and one-off alike.
model Expense {
  id           String    @id @default(cuid())
  agencyId     String
  name         String
  /// Schedule C category key from @toreroflow/core.
  categoryLine String
  /// Null means the bill is not known yet. Deliberately not zero: treating an
  /// unknown cost as free overstates profit every month.
  amountCents  Int?
  month        String
  /// recurring rolls forward into the next month. one_off never does.
  kind         String    @default("recurring")
  /// A recurring cost whose amount changes monthly, so it rolls forward null.
  variable     Boolean   @default(false)
  /// one_off only: the date it actually happened, for the tax record.
  incurredOn   DateTime?
  color        String?
  note         String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  agency Agency @relation(fields: [agencyId], references: [id])

  @@index([agencyId, month])
}

/// Marks a financial month as opened, so roll-forward runs exactly once.
///
/// Counting existing expenses cannot tell "never opened" from "emptied on
/// purpose", so a user who deleted every cost had them silently restored by
/// the next page load. The unique constraint also makes opening a month
/// atomic: two concurrent requests race to insert and only one wins, where
/// a count-then-insert let both through and duplicated every carried cost.
model FinancialMonth {
  id       String   @id @default(cuid())
  agencyId String
  /// "2026-07"
  month    String
  openedAt DateTime @default(now())

  agency Agency @relation(fields: [agencyId], references: [id])

  @@unique([agencyId, month])
}

/// A document, never a charge. Phase 1 cannot move money.
model Invoice {
  id          String   @id @default(cuid())
  agencyId    String
  clientId    String
  /// Sequential per agency from 1. Never reused, never renumbered: a deleted
  /// invoice burns its number rather than leaving a gap to backfill.
  number      Int
  issuedAt    DateTime @default(now())
  periodStart DateTime
  periodEnd   DateTime
  amountCents Int
  status      String   @default("draft")
  storageKey  String?
  /// Snapshot of what was delivered, not a live join: an invoice must show
  /// what it showed the day it was issued.
  lineItems   Json
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  agency Agency @relation(fields: [agencyId], references: [id])
  client Client @relation(fields: [clientId], references: [id])

  @@unique([agencyId, number])
  @@index([clientId])
}
