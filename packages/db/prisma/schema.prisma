generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  owner
  viewer
}

enum Platform {
  instagram
  tiktok
  youtube
  snapchat
  facebook
}

enum SocialAccountStatus {
  connected
  needs_reconnect
  error
}

enum MediaAssetStatus {
  uploaded
  processing
  ready
  failed
}

enum RenderStatus {
  queued
  processing
  ready
  failed
}

enum PostStatus {
  draft
  scheduled
  publishing
  posted
  failed
}

enum PostTargetStatus {
  scheduled
  publishing
  posted
  failed
}

enum ScheduleSource {
  best_time
  manual
}

enum VideoFormat {
  short_form
  long_form
}

enum JobStatus {
  queued
  active
  completed
  failed
}

model Agency {
  id         String   @id @default(cuid())
  name       String
  ownerEmail String
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  users   User[]
  clients Client[]
}

model User {
  id           String   @id @default(cuid())
  agencyId     String
  email        String   @unique
  passwordHash String
  role         UserRole @default(owner)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  agency Agency @relation(fields: [agencyId], references: [id])
  posts  Post[]
}

model Client {
  id                String    @id @default(cuid())
  agencyId          String
  name              String
  avatarSeed        String?
  plan              String?
  /// Publishing provider workspace id (Zernio profile _id) backing this client.
  providerProfileId String?
  /// Short-form videos owed this pay period; null means not tracked.
  quotaShort        Int?
  /// Long-form videos owed this pay period; null means not tracked.
  quotaLong         Int?
  /// Start of the current pay period. Uploads after this count toward quota.
  quotaResetAt      DateTime?
  /// Manual corrections applied on top of the counted uploads, per format.
  adjustShort       Int       @default(0)
  adjustLong        Int       @default(0)
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  deletedAt  DateTime?

  agency         Agency          @relation(fields: [agencyId], references: [id])
  socialAccounts SocialAccount[]
  mediaAssets    MediaAsset[]
  posts          Post[]
  scheduleSlots  ScheduleSlot[]
  workflows      Workflow[]

  @@index([agencyId])
}

model SocialAccount {
  id                String              @id @default(cuid())
  clientId          String
  platform          Platform
  handle            String
  providerAccountId String?
  status            SocialAccountStatus @default(connected)
  /// Encrypted blob (libsodium sealed box / KMS). Never store plaintext tokens.
  tokensEncrypted   String?
  /// Profile picture and display name captured from the platform via the provider.
  avatarUrl         String?
  displayName       String?
  scopes            String[]            @default([])
  connectedAt       DateTime            @default(now())
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt
  deletedAt         DateTime?

  client          Client           @relation(fields: [clientId], references: [id])
  postTargets     PostTarget[]
  metricSnapshots MetricSnapshot[]
  externalVideos  ExternalVideo[]

  @@index([clientId, platform])
}

model MediaAsset {
  id           String           @id @default(cuid())
  clientId     String
  storageKey   String
  originalName String
  durationSec  Float?
  width        Int?
  height       Int?
  status       MediaAssetStatus @default(uploaded)
  /// Timestamped transcript from the captions service: [{ start, end, text }]
  transcript   Json?
  /// AI-drafted post copy: { title, description, hashtags[] } (operator-editable)
  draftCopy    Json?
  /// Short-form or long-form, for quota purposes. Filled from duration
  /// during processing when still unset; the operator can override it.
  format       VideoFormat?
  /// A re-edit of an earlier upload: excluded from the client's video quota.
  isRevision   Boolean          @default(false)
  /// The upload this one revises, when known.
  revisionOfId String?
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt

  client     Client       @relation(fields: [clientId], references: [id])
  renders    Render[]
  posts      Post[]
  revisionOf MediaAsset?  @relation("AssetRevisions", fields: [revisionOfId], references: [id])
  revisions  MediaAsset[] @relation("AssetRevisions")

  @@index([clientId, status])
}

model Render {
  id           String       @id @default(cuid())
  mediaAssetId String
  platform     Platform
  aspect       String       @default("9:16")
  storageKey   String
  captionStyle String?
  status       RenderStatus @default(queued)
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  mediaAsset MediaAsset @relation(fields: [mediaAssetId], references: [id])

  @@index([mediaAssetId])
}

model Post {
  id           String     @id @default(cuid())
  clientId     String
  mediaAssetId String?
  createdById  String
  status       PostStatus @default(draft)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  deletedAt    DateTime?

  client     Client       @relation(fields: [clientId], references: [id])
  mediaAsset MediaAsset?  @relation(fields: [mediaAssetId], references: [id])
  createdBy  User         @relation(fields: [createdById], references: [id])
  targets    PostTarget[]

  @@index([clientId, status])
}

model PostTarget {
  id              String           @id @default(cuid())
  postId          String
  socialAccountId String
  platform        Platform
  caption         String?
  hashtags        String[]         @default([])
  scheduledAt     DateTime?
  status          PostTargetStatus @default(scheduled)
  remotePostId    String?
  remoteUrl       String?
  error           String?
  publishedAt     DateTime?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  post          Post          @relation(fields: [postId], references: [id])
  socialAccount SocialAccount @relation(fields: [socialAccountId], references: [id])
  postMetrics   PostMetric[]

  @@index([status, scheduledAt])
  @@index([socialAccountId])
}

/// Repurpose.io-style fan-out rule: a video posted to sourcePlatform for this
/// client is automatically republished to every platform in destinations.
model Workflow {
  id             String     @id @default(cuid())
  clientId       String
  name           String
  sourcePlatform Platform
  destinations   Platform[] @default([])
  enabled        Boolean    @default(true)
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt

  client Client @relation(fields: [clientId], references: [id])

  @@index([clientId, enabled])
}

model ScheduleSlot {
  id        String         @id @default(cuid())
  clientId  String
  platform  Platform
  dayOfWeek Int
  hourLocal Int
  source    ScheduleSource @default(manual)
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt

  client Client @relation(fields: [clientId], references: [id])

  @@index([clientId, platform])
}

/**
 * A video that already existed on the platform, pulled straight from the
 * platform's own API rather than the publishing provider.
 *
 * The provider only exposes a rolling window of recent posts, so lifetime
 * rankings ("most viewed of all time") need the platform as the source of
 * truth. View counts here are authoritative and refreshed on each sync.
 */
model ExternalVideo {
  id              String   @id @default(cuid())
  socialAccountId String
  platform        Platform
  /// The platform's own video id (e.g. a YouTube videoId).
  platformVideoId String
  title           String
  thumbnailUrl    String?
  url             String?
  publishedAt     DateTime
  views           Int      @default(0)
  likes           Int      @default(0)
  comments        Int      @default(0)
  durationSec     Float?
  fetchedAt       DateTime @default(now())
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  socialAccount SocialAccount @relation(fields: [socialAccountId], references: [id])

  @@unique([socialAccountId, platformVideoId])
  @@index([socialAccountId, views])
  @@index([socialAccountId, publishedAt])
}

model MetricSnapshot {
  id              String   @id @default(cuid())
  socialAccountId String
  capturedAt      DateTime
  views           Int?
  reach           Int?
  followers       Int?
  engagementRate  Float?
  avgWatchSec     Float?
  raw             Json?
  createdAt       DateTime @default(now())

  socialAccount SocialAccount @relation(fields: [socialAccountId], references: [id])

  @@index([socialAccountId, capturedAt])
}

model PostMetric {
  id           String   @id @default(cuid())
  postTargetId String
  capturedAt   DateTime
  views        Int?
  likes        Int?
  comments     Int?
  shares       Int?
  saves        Int?
  createdAt    DateTime @default(now())

  postTarget PostTarget @relation(fields: [postTargetId], references: [id])

  @@index([postTargetId, capturedAt])
}

/// Mirror of queue state so the UI can show job health without talking to Redis.
model Job {
  id        String    @id @default(cuid())
  type      String
  refId     String?
  status    JobStatus @default(queued)
  attempts  Int       @default(0)
  lastError String?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@index([type, status])
}
