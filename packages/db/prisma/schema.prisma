generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  owner
  viewer
}

enum Platform {
  instagram
  tiktok
  youtube
  snapchat
  facebook
}

enum SocialAccountStatus {
  connected
  needs_reconnect
  error
}

enum MediaAssetStatus {
  uploaded
  processing
  ready
  failed
}

enum RenderStatus {
  queued
  processing
  ready
  failed
}

enum PostStatus {
  draft
  scheduled
  publishing
  posted
  failed
}

enum PostTargetStatus {
  scheduled
  publishing
  posted
  failed
}

enum ScheduleSource {
  best_time
  manual
}

enum VideoFormat {
  short_form
  long_form
}

enum JobStatus {
  queued
  active
  completed
  failed
}

model Agency {
  id               String   @id @default(cuid())
  name             String
  ownerEmail       String
  /// Stamped onto the year-end export. A CPA needs these, not just totals.
  legalName        String?
  ein              String?
  /// Free text, printed on invoices and the year-end export. A registered
  /// company's documents carry an address; a person's spreadsheet does not.
  businessAddress  String?
  /// NAICS principal business activity code.
  businessCode     String?
  /// cash or accrual. Decides whether unpaid revenue appears in the export.
  accountingMethod String?  @default("cash")
  /// Two letter state, for the tax estimate. Decides the state rate applied to
  /// profit that passes through to the owner.
  taxState         String?
  /// single | married_joint | head_of_household. Decides the brackets used.
  filingStatus     String?  @default("single")
  /// Wages and anything else taxed the same way, so the estimate knows which
  /// bracket the business profit actually lands in.
  otherIncomeCents Int?
  /// Overrides the built-in state rate, as a percentage. A table of state rates
  /// goes stale every January, so the operator can always correct it.
  stateTaxRatePct  Float?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  users           User[]
  clients         Client[]
  alerts          SystemAlert[]
  revenueEntries  RevenueEntry[]
  expenses        Expense[]
  invoices        Invoice[]
  financialMonths FinancialMonth[]
  bankConnections BankConnection[]
}

/**
 * Something that failed in the background, kept until it stops failing.
 * Scheduled work has no operator watching it: a month-end republish that
 * fails at 3am only reaches a log file, so a client's page can sit stale for
 * weeks while the app looks healthy. These rows are what the app reads to say
 * otherwise.
 * Deliberately a live list of what is broken now, not an audit log. A check
 * that succeeds deletes its row, so a problem that fixed itself leaves
 * nothing behind to explain away. The API log keeps the history.
 */
model SystemAlert {
  id       String  @id @default(cuid())
  agencyId String
  /// Stable identity for one recurring problem, e.g.
  /// "report_publish_failed:<clientId>". A repeat updates this row rather
  /// than stacking, so one broken thing reads as one problem.
  key      String
  kind     String
  /// "error" blocks something working; "warning" still needs attention.
  severity String  @default("error")
  clientId String?
  /// Written for the operator, and says what to do about it.
  message  String
  /// The underlying failure, for when the message is not enough.
  detail   String?
  count    Int     @default(1)

  firstSeenAt DateTime  @default(now())
  lastSeenAt  DateTime  @default(now())
  /// Acknowledged by the operator. Cleared again if it recurs, because a
  /// second failure after acknowledging is new information.
  dismissedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  agency Agency  @relation(fields: [agencyId], references: [id])
  client Client? @relation(fields: [clientId], references: [id])

  @@unique([agencyId, key])
  @@index([agencyId, dismissedAt])
}

model User {
  id           String   @id @default(cuid())
  agencyId     String
  email        String   @unique
  passwordHash String
  role         UserRole @default(owner)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  agency Agency @relation(fields: [agencyId], references: [id])
  posts  Post[]
}

model Client {
  id                   String         @id @default(cuid())
  agencyId             String
  name                 String
  avatarSeed           String?
  plan                 String?
  /// Publishing provider workspace id (Zernio profile _id) backing this client.
  providerProfileId    String?
  /// Short-form videos owed this pay period; null means not tracked.
  quotaShort           Int?
  /// Long-form videos owed this pay period; null means not tracked.
  quotaLong            Int?
  /// Start of the current pay period. Uploads after this count toward quota.
  quotaResetAt         DateTime?
  /// Manual corrections applied on top of the counted uploads, per format.
  adjustShort          Int            @default(0)
  adjustLong           Int            @default(0)
  /// Who to actually contact at this client, kept here rather than in a head.
  /// Separate from `name`, which is the brand: the brand is "CACV Motors" and
  /// the person answering the phone is someone else.
  contactName          String?
  contactEmail         String?
  contactPhone         String?
  /// Permanent path of this client's shareable web report, e.g.
  /// "northstar-end-of-month-report". Assigned once and never regenerated on
  /// rename, because the link may already be sitting in a client's inbox.
  reportSlug           String?        @unique
  /// Absolute URL of the last published report page; null until first publish.
  reportUrl            String?
  /// When that page was last pushed. Also the flag month-end republishing
  /// reads: a client that has never been published is never published for them.
  reportPublishedAt    DateTime?
  /// Reporting month the published page currently leads with ("2026-06").
  reportPublishedMonth String?
  /// Current retainer. A default for seeding a month, not a historical record:
  /// history lives in RevenueEntry, so raising this leaves past months alone.
  monthlyPriceCents    Int?
  /// calendar: paid monthly regardless of delivery.
  /// on_fulfilment: the next payment is not due until the last block ships.
  billingMode          String         @default("calendar")
  revenueEntries       RevenueEntry[]
  invoices             Invoice[]
  createdAt            DateTime       @default(now())
  updatedAt            DateTime       @updatedAt
  deletedAt            DateTime?

  agency         Agency          @relation(fields: [agencyId], references: [id])
  socialAccounts SocialAccount[]
  mediaAssets    MediaAsset[]
  posts          Post[]
  scheduleSlots  ScheduleSlot[]
  workflows      Workflow[]
  reports        ClientReport[]
  alerts         SystemAlert[]
  insight        ClientInsight?
  inspirations   InspirationAccount[]
  researchRuns   ResearchRun[]

  @@index([agencyId])
}

/// The latest "what to do next" run for a client, and where its PDF landed.
///
/// One row per client, overwritten per run: the question has one answer, and
/// a growing pile of stale advice is a list nobody reads. Generation happens
/// on the worker's `insights` queue, so this row is also how the app knows a
/// run is still going.
model ClientInsight {
  id          String    @id @default(cuid())
  clientId    String    @unique
  /// running | ready | failed. See packages/core/src/insightStatus.ts.
  status      String
  /// The model's suggestions, in the shape the modal renders.
  suggestions Json?
  /// Storage path of the rendered PDF, served from /files/<key>.
  storageKey  String?
  /// Why the last run failed, shown when the modal reopens.
  error       String?
  requestedAt DateTime  @default(now())
  completedAt DateTime?

  client Client @relation(fields: [clientId], references: [id], onDelete: Cascade)
}

model SocialAccount {
  id                String              @id @default(cuid())
  clientId          String
  platform          Platform
  handle            String
  providerAccountId String?
  status            SocialAccountStatus @default(connected)
  /// Encrypted blob (libsodium sealed box / KMS). Never store plaintext tokens.
  tokensEncrypted   String?
  /// Profile picture and display name captured from the platform via the provider.
  avatarUrl         String?
  displayName       String?
  scopes            String[]            @default([])
  connectedAt       DateTime            @default(now())
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt
  deletedAt         DateTime?

  client          Client           @relation(fields: [clientId], references: [id])
  postTargets     PostTarget[]
  metricSnapshots MetricSnapshot[]
  externalVideos  ExternalVideo[]

  @@index([clientId, platform])
}

model MediaAsset {
  id           String           @id @default(cuid())
  clientId     String
  storageKey   String
  originalName String
  durationSec  Float?
  width        Int?
  height       Int?
  status       MediaAssetStatus @default(uploaded)
  /// Timestamped transcript from the captions service: [{ start, end, text }]
  transcript   Json?
  /// AI-drafted post copy: { title, description, hashtags[] } (operator-editable)
  draftCopy    Json?
  /// Short-form or long-form, for quota purposes. Filled from duration
  /// during processing when still unset; the operator can override it.
  format       VideoFormat?
  /// A re-edit of an earlier upload: excluded from the client's video quota.
  isRevision   Boolean          @default(false)
  /// The upload this one revises, when known.
  revisionOfId String?
  /// Millisecond offset of the operator-chosen cover frame, when frame-picked.
  coverOffsetMs Int?
  /// Storage key of the chosen cover image (frame-extracted or uploaded).
  coverKey      String?
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt

  client     Client       @relation(fields: [clientId], references: [id])
  renders    Render[]
  posts      Post[]
  revisionOf MediaAsset?  @relation("AssetRevisions", fields: [revisionOfId], references: [id])
  revisions  MediaAsset[] @relation("AssetRevisions")

  @@index([clientId, status])
}

model Render {
  id           String       @id @default(cuid())
  mediaAssetId String
  platform     Platform
  aspect       String       @default("9:16")
  storageKey   String
  captionStyle String?
  status       RenderStatus @default(queued)
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  mediaAsset MediaAsset @relation(fields: [mediaAssetId], references: [id])

  @@index([mediaAssetId])
}

model Post {
  id           String     @id @default(cuid())
  clientId     String
  mediaAssetId String?
  createdById  String
  status       PostStatus @default(draft)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  deletedAt    DateTime?

  client     Client       @relation(fields: [clientId], references: [id])
  mediaAsset MediaAsset?  @relation(fields: [mediaAssetId], references: [id])
  createdBy  User         @relation(fields: [createdById], references: [id])
  targets    PostTarget[]

  @@index([clientId, status])
}

model PostTarget {
  id              String           @id @default(cuid())
  postId          String
  socialAccountId String
  platform        Platform
  caption         String?
  hashtags        String[]         @default([])
  /// Per-platform publish options: { instagram: {...} } or { youtubeTitle }.
  options         Json?
  scheduledAt     DateTime?
  status          PostTargetStatus @default(scheduled)
  remotePostId    String?
  remoteUrl       String?
  error           String?
  publishedAt     DateTime?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  post          Post          @relation(fields: [postId], references: [id])
  socialAccount SocialAccount @relation(fields: [socialAccountId], references: [id])
  postMetrics   PostMetric[]

  @@index([status, scheduledAt])
  @@index([socialAccountId])
}

/// Repurpose.io-style fan-out rule: a video posted to sourcePlatform for this
/// client is automatically republished to every platform in destinations.
model Workflow {
  id             String     @id @default(cuid())
  clientId       String
  name           String
  sourcePlatform Platform
  destinations   Platform[] @default([])
  enabled        Boolean    @default(true)
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt

  client Client @relation(fields: [clientId], references: [id])

  @@index([clientId, enabled])
}

model ScheduleSlot {
  id        String         @id @default(cuid())
  clientId  String
  platform  Platform
  dayOfWeek Int
  hourLocal Int
  source    ScheduleSource @default(manual)
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt

  client Client @relation(fields: [clientId], references: [id])

  @@index([clientId, platform])
}

/**
 * A generated client report for one calendar month.
 * The payload the PDF was built from is stored alongside it, so a report can
 * be re-rendered later without recomputing analytics that may since have
 * moved. `seenAt` drives the month-end notification.
 */
model ClientReport {
  id          String    @id @default(cuid())
  clientId    String
  /// First moment of the reporting month.
  periodStart DateTime
  periodEnd   DateTime
  /// Storage path of the rendered PDF.
  storageKey  String
  /// Exact JSON the template rendered, kept for reproducibility.
  data        Json
  generatedAt DateTime  @default(now())
  /// Null until the operator has opened it; the bell reads this.
  seenAt      DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  client Client @relation(fields: [clientId], references: [id])

  @@unique([clientId, periodStart])
  @@index([clientId, periodStart])
}

/**
 * A video that already existed on the platform, pulled straight from the
 * platform's own API rather than the publishing provider.
 * The provider only exposes a rolling window of recent posts, so lifetime
 * rankings ("most viewed of all time") need the platform as the source of
 * truth. View counts here are authoritative and refreshed on each sync.
 */
model ExternalVideo {
  id              String   @id @default(cuid())
  socialAccountId String
  platform        Platform
  /// The platform's own video id (e.g. a YouTube videoId).
  platformVideoId String
  title           String
  thumbnailUrl    String?
  url             String?
  publishedAt     DateTime
  views           Int      @default(0)
  likes           Int      @default(0)
  comments        Int      @default(0)
  durationSec     Float?
  fetchedAt       DateTime @default(now())
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  socialAccount SocialAccount         @relation(fields: [socialAccountId], references: [id])
  metrics       ExternalVideoMetric[]

  @@unique([socialAccountId, platformVideoId])
  @@index([socialAccountId, views])
  @@index([socialAccountId, publishedAt])
}

/// One row per external video per UTC day. Nothing reads this yet, on
/// purpose: it is the rolling history future views-over-time charts and
/// the site view counter draw from, accumulating from ship day.
model ExternalVideoMetric {
  id              String   @id @default(cuid())
  externalVideoId String
  /// UTC calendar date of the capture; one row per video per day.
  capturedOn      DateTime @db.Date
  views           Int      @default(0)
  likes           Int      @default(0)
  comments        Int      @default(0)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  externalVideo ExternalVideo @relation(fields: [externalVideoId], references: [id], onDelete: Cascade)

  @@unique([externalVideoId, capturedOn])
}

model MetricSnapshot {
  id              String   @id @default(cuid())
  socialAccountId String
  capturedAt      DateTime
  views           Int?
  reach           Int?
  followers       Int?
  engagementRate  Float?
  avgWatchSec     Float?
  raw             Json?
  createdAt       DateTime @default(now())

  socialAccount SocialAccount @relation(fields: [socialAccountId], references: [id])

  @@index([socialAccountId, capturedAt])
}

model PostMetric {
  id           String   @id @default(cuid())
  postTargetId String
  capturedAt   DateTime
  views        Int?
  likes        Int?
  comments     Int?
  shares       Int?
  saves        Int?
  createdAt    DateTime @default(now())

  postTarget PostTarget @relation(fields: [postTargetId], references: [id])

  @@index([postTargetId, capturedAt])
}

/// Mirror of queue state so the UI can show job health without talking to Redis.
model Job {
  id        String    @id @default(cuid())
  type      String
  refId     String?
  status    JobStatus @default(queued)
  attempts  Int       @default(0)
  lastError String?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@index([type, status])
}

/// What one client owes for one month.
model RevenueEntry {
  id          String    @id @default(cuid())
  agencyId    String
  clientId    String
  /// "2026-06"
  month       String
  amountCents Int
  /// Set means paid. The only stored state: pending and due are derived, since
  /// a stored "not due" goes stale the moment a video is delivered.
  receivedAt  DateTime?
  note        String?
  color       String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  agency Agency @relation(fields: [agencyId], references: [id])
  client Client @relation(fields: [clientId], references: [id])

  @@unique([clientId, month])
  @@index([agencyId, month])
}

/// One cost in one month. Holds recurring and one-off alike.
model Expense {
  id           String    @id @default(cuid())
  agencyId     String
  name         String
  /// Schedule C category key from @toreroflow/core.
  categoryLine String
  /// Null means the bill is not known yet. Deliberately not zero: treating an
  /// unknown cost as free overstates profit every month.
  amountCents  Int?
  month        String
  /// recurring rolls forward into the next month. one_off never does.
  kind         String    @default("recurring")
  /// A recurring cost whose amount changes monthly, so it rolls forward null.
  variable     Boolean   @default(false)
  /// one_off only: the date it actually happened, for the tax record.
  incurredOn   DateTime?
  color        String?
  note         String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  agency Agency @relation(fields: [agencyId], references: [id])

  @@index([agencyId, month])
}

/// Marks a financial month as opened, so roll-forward runs exactly once.
///
/// Counting existing expenses cannot tell "never opened" from "emptied on
/// purpose", so a user who deleted every cost had them silently restored by
/// the next page load. The unique constraint also makes opening a month
/// atomic: two concurrent requests race to insert and only one wins, where
/// a count-then-insert let both through and duplicated every carried cost.
model FinancialMonth {
  id       String   @id @default(cuid())
  agencyId String
  /// "2026-07"
  month    String
  openedAt DateTime @default(now())

  agency Agency @relation(fields: [agencyId], references: [id])

  @@unique([agencyId, month])
}

/// A document, never a charge. Phase 1 cannot move money.
model Invoice {
  id          String   @id @default(cuid())
  agencyId    String
  clientId    String
  /// Sequential per agency from 1. Never reused, never renumbered: a deleted
  /// invoice burns its number rather than leaving a gap to backfill.
  number      Int
  issuedAt    DateTime @default(now())
  periodStart DateTime
  periodEnd   DateTime
  amountCents Int
  status      String   @default("draft")
  storageKey  String?
  /// Snapshot of what was delivered, not a live join: an invoice must show
  /// what it showed the day it was issued.
  lineItems   Json
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  agency Agency @relation(fields: [agencyId], references: [id])
  client Client @relation(fields: [clientId], references: [id])

  @@unique([agencyId, number])
  @@index([clientId])
}

/// An account a client named at signup as one they want their content to be like.
///
/// One row per platform: a client who says "both" for a handle gets two rows,
/// so `externalId` stays single valued and a snapshot always belongs to one
/// real account on one real app.
model InspirationAccount {
  id          String    @id @default(cuid())
  clientId    String
  /// instagram | tiktok. Recorded from the website form.
  platform    String
  /// Exactly as the client typed it, minus the @ and any profile URL wrapper.
  handle      String
  /// What they called the account, if they gave it a name.
  displayName String?
  /// The platform's own id for this account. Instagram wants a numeric user
  /// id and TikTok a secUid, and neither posts endpoint accepts a handle, so
  /// this is resolved once and reused rather than paid for on every run.
  externalId  String?
  /// Set when the operator has eyeballed the resolved account and agreed it
  /// is the right person. Nothing expensive runs before this.
  confirmedAt DateTime?
  /// Why the last resolve failed, so a bad handle explains itself.
  error       String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  client    Client               @relation(fields: [clientId], references: [id], onDelete: Cascade)
  snapshots CompetitorSnapshot[]

  /// The same handle on the same app is one account, however often it arrives.
  @@unique([clientId, platform, handle])
  @@index([clientId])
}

/// One paid fetch of what an inspiration account has been posting.
///
/// The provider payload is kept verbatim. Every fetch costs real money, so
/// throwing away fields we did not think to parse would mean paying twice for
/// the same data the first time a later phase wants something new.
model CompetitorSnapshot {
  id        String   @id @default(cuid())
  accountId String
  runId     String?
  fetchedAt DateTime @default(now())
  raw       Json
  /// Integer cents, so the run ceiling is enforceable without float drift.
  costCents Int      @default(0)

  account InspirationAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)
  run     ResearchRun?       @relation(fields: [runId], references: [id], onDelete: SetNull)

  @@index([accountId, fetchedAt])
}

/// One press of the research button.
///
/// Carries its own spending ceiling. Research is never scheduled and never
/// retried automatically: an unattended loop against a metered API is how a
/// prepaid wallet empties overnight.
model ResearchRun {
  id          String    @id @default(cuid())
  clientId    String
  /// running | ready | failed. Same vocabulary as ClientInsight.
  status      String
  /// Agreed before the run starts. It stops when it reaches this.
  maxCents    Int
  spentCents  Int       @default(0)
  error       String?
  requestedAt DateTime  @default(now())
  completedAt DateTime?

  client    Client               @relation(fields: [clientId], references: [id], onDelete: Cascade)
  snapshots CompetitorSnapshot[]

  @@index([clientId, requestedAt])
}

/// A linked bank, for read-only oversight of the agency's own money.
///
/// Agency-level, not per client: this is Tyrone's business account, not a
/// client's. Nothing in this feature can move money in either direction; it
/// reads balances and transactions and nothing else.
model BankConnection {
  id              String    @id @default(cuid())
  agencyId        String
  /// The provider's identifier for this link. Unique so reconnecting the same
  /// bank updates the row rather than stacking a second copy of every account.
  itemId          String    @unique
  /// The provider's id for the bank itself, which survives a relink where
  /// itemId does not. Stored so a second link to a bank that is already
  /// connected can be refused: both items' accounts would default into cash
  /// flow and every figure would double. Null when the lookup failed, and a
  /// null never matches another null.
  institutionId   String?
  institutionName String?
  /// The access token, encrypted with packages/db/src/secrets.ts. Never
  /// written in plaintext: this is a long-lived key to a real bank's
  /// transaction history.
  accessTokenEnc  String
  /// Where the incremental transaction sync left off. Null means never synced,
  /// which is different from synced and finding nothing.
  cursor          String?
  /// active | needs_reconnect | error. A bank that wants re-authentication is
  /// not broken, and reads differently to a failure.
  status          String    @default("active")
  /// Why the last sync failed, so a stale feed explains itself.
  error           String?
  lastSyncedAt    DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  agency   Agency        @relation(fields: [agencyId], references: [id], onDelete: Cascade)
  accounts BankAccount[]

  @@index([agencyId])
}

/// One account inside a linked bank.
model BankAccount {
  id              String  @id @default(cuid())
  connectionId    String
  plaidAccountId  String  @unique
  name            String
  officialName    String?
  /// Last four digits, for telling two accounts apart on screen.
  mask            String?
  /// depository | credit | loan | investment | other.
  type            String?
  subtype         String?
  /// Integer cents, like every other figure in this app. Null when the
  /// provider has no figure, which is not the same as zero.
  currentCents    Int?
  availableCents  Int?
  currency        String  @default("USD")
  /// Whether this account counts towards money in and money out.
  ///
  /// Defaults from the account type: a single link returns a mortgage, a 401k
  /// and student loans alongside the checking account, and folding those into
  /// cash flow would make the number meaningless. Still an operator decision,
  /// because only they know which account the business actually runs on.
  includeInCashFlow Boolean @default(false)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  connection   BankConnection    @relation(fields: [connectionId], references: [id], onDelete: Cascade)
  transactions BankTransaction[]

  @@index([connectionId])
}

/// One transaction on a linked account.
model BankTransaction {
  id                 String  @id @default(cuid())
  accountId          String
  plaidTransactionId String  @unique
  /// ISO "2026-07-26", stored as text on purpose.
  ///
  /// This is a date, not an instant. Putting it in a timestamp column invites
  /// the classic off-by-one where a transaction slides into the previous month
  /// depending on the reader's timezone, and month totals are the whole point
  /// of this feature. ISO strings also sort and range-query correctly.
  date               String
  name               String
  merchantName       String?
  /// Integer cents in OUR convention: positive means money arrived.
  ///
  /// Deliberately not the provider's sign, which is inverted (positive means
  /// money left the account). The flip happens once, in
  /// packages/core/src/banking.ts, so nothing downstream has to remember it.
  amountCents        Int
  /// Pending rows can change amount or vanish, so totals exclude them.
  pending            Boolean @default(false)
  category           String?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  account BankAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@index([accountId, date])
}
