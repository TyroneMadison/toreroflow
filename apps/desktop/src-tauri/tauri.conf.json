{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Toreroflow",
  "version": "0.3.4",
  "identifier": "com.torerone.toreroflow",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Toreroflow",
        "width": 1440,
        "height": 900,
        "minWidth": 1080,
        "minHeight": 700,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEQyMzkwMEYyQjQ4NTIyOTQKUldTVUlvVzA4Z0E1MGdqeEQrUUovRkVtbGZteXI1MVZaTUVuV21pUGhENVRSRVJIVGJZdkxzajQK",
      "endpoints": [
        "https://github.com/TyroneMadison/toreroflow/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
