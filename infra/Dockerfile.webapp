# The desktop UI, served as a plain web page.
#
# The app was always a Vite web app; Tauri only wraps it in a window and an
# updater. Serving the same build over HTTPS gives every browser on any OS the
# whole interface - which is what lets an automation on a Linux VM, or the
# operator's phone, drive the app without a native port. The few Tauri-only
# features (updater, autostart) detect the shell and stand down in a browser.
#
# Built from the repo root so the pnpm workspace packages resolve.

FROM node:22-alpine AS build
RUN corepack enable
WORKDIR /repo
COPY . .
RUN pnpm install --frozen-lockfile
# The API address is baked in at build time, same as the desktop release.
ARG VITE_API_URL
ENV VITE_API_URL=${VITE_API_URL}
RUN pnpm --filter @toreroflow/desktop build

FROM caddy:2-alpine
COPY --from=build /repo/apps/desktop/dist /srv
# A single-page app: unknown paths fall back to index.html, assets get long
# cache lives because Vite fingerprints them.
RUN printf ':80 {\n\troot * /srv\n\tencode zstd gzip\n\ttry_files {path} /index.html\n\theader /assets/* Cache-Control "public, max-age=31536000, immutable"\n\tfile_server\n}\n' > /etc/caddy/Caddyfile
