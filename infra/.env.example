# The server's secrets. Copy to infra/.env on the box and fill in.
#
#   cp infra/.env.example infra/.env
#
# infra/.env is gitignored and must stay that way. Nothing in here belongs in a
# repository, and this one is public.

# ---------------------------------------------------------------------------
# Required. The API refuses to start in production without these.
# ---------------------------------------------------------------------------

# The domain the API answers on. Caddy requests the certificate for exactly
# this name, so it has to resolve to this box before the stack comes up.
API_DOMAIN=api.torerone.com

# Signs operator sessions and every /files/ link.
#   openssl rand -base64 48
# Changing it logs you out and invalidates every outstanding file link, which
# is the correct thing to do if it ever leaks.
JWT_SECRET=

# Encrypts the bank credential at rest.
#   openssl rand -base64 32
# Changing it makes existing bank connections undecryptable and they have to be
# reconnected. Back this one up somewhere you will still have it in a year.
TOKEN_ENCRYPTION_KEY=

# The database password.
#   openssl rand -base64 24
# Postgres only ever sets this on the FIRST boot of an empty data directory.
# Changing it later does not change the database's password, it just stops the
# API being able to log in. To rotate it properly, ALTER USER inside Postgres
# and change it here in the same maintenance window.
POSTGRES_PASSWORD=

# Origins allowed to make cross-site requests, comma separated.
#
# All four matter, and the scheme is not guessable, so do not trim this list:
#   http://tauri.localhost   Windows, and it is HTTP, not HTTPS
#   https://tauri.localhost  Windows on some versions
#   tauri://localhost        macOS and Linux
#   http://localhost:1420    the dev server
#
# Getting this wrong does not look like a CORS problem from the app's side. It
# looks like the API being down: the request is blocked by the browser before
# it is sent, so the app reports "API offline" while the server is perfectly
# healthy and answering curl.
ALLOWED_ORIGINS=http://tauri.localhost,https://tauri.localhost,tauri://localhost,http://localhost:1420

# ---------------------------------------------------------------------------
# Optional. Each one is a feature that stays off rather than an error.
# ---------------------------------------------------------------------------

# Publishing. `dryrun` schedules without sending anything anywhere, which is
# the right setting until you have confirmed the rest of the stack works.
PUBLISH_PROVIDER=dryrun
PUBLISH_PROVIDER_API_KEY=

# Drafts captions and writes the game plans. Empty means those endpoints
# answer 503 with an explanation rather than failing halfway through.
ANTHROPIC_API_KEY=

# Publishes the client-facing report pages.
NETLIFY_AUTH_TOKEN=
NETLIFY_SITE_ID=
REPORTS_PUBLIC_BASE=

# Reads a channel's lifetime catalogue, which the publishing provider does not
# expose. Empty means all-time YouTube rankings stay unavailable.
YOUTUBE_API_KEY=

# Competitor research. Empty disables the research queue.
MONID_API_KEY=

# The timezone a bank transaction's calendar day is decided in. Without this a
# server running in UTC files an evening payment under the next day, which at a
# month boundary moves money between months.
BUSINESS_TIMEZONE=America/New_York

# Days a posted video keeps its source file before the daily sweep clears it.
# The source is around 95% of everything stored, so this is the number that
# decides how much disk the app uses.
RETENTION_DAYS=7

# Days a posted video keeps its thumbnail and cover. Much longer, because an
# image is roughly a five-hundredth of the video and is what every calendar,
# queue and upload card draws. Past this the card keeps its title, platform,
# status and time and loses only the picture.
#
# This one cannot be undone: the frame is cut from the source, and the source
# went three weeks earlier, so nothing can rebuild it. Floored at 7 days.
THUMB_RETENTION_DAYS=30

# Reminder accounts: email delivery for personal profiles that post by hand.
RESEND_API_KEY=
REMINDER_FROM=hello@torerone.com
PUBLIC_API_URL=https://toreroflow-server.tail0aa167.ts.net
